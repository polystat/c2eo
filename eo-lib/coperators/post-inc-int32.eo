+alias c2eo.coperators.read-as-int32
+alias c2eo.coperators.write-as-int32

+package c2eo.coperators

[a] > post-inc-int32
  seq > @
    write-as-int32 a ((read-as-int32 a).plus 1)
    (read-as-int32 a).minus 1
