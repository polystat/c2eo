+package c2eo.coperators

[mem addr] > address

  [size-bytes] > read
    mem.slice addr size-bytes > @

  [value] > write
    mem.write addr (value.as-bytes) > @

  [value] > plus
    address mem (addr.plus value) > @

  [value] > minus
    address mem (addr.minus value) > @
