+alias c2eo.coperators.read-as-int16
+alias c2eo.coperators.write-as-int16

+package c2eo.coperators

[a] > post-dec-int16
  seq > @
    write-as-int16 a ((read-as-int16 a).minus 1)
    (read-as-int16 a).plus 1
