+alias c2eo.coperators.read-as-uint8
+alias c2eo.coperators.write-as-uint8

+package c2eo.coperators

[a] > post-inc-uint8
  seq > @
    write-as-uint8 a ((read-as-uint8 a).plus 1)
    (read-as-uint8 a).minus 1
